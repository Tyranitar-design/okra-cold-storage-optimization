# ============================================================
# 秋葵冷库优化项目 — 环境变量模板
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，勿提交
# ============================================================

# ── 数据库 ───────────────────────────────────────────────────
# 仅在显式配置 OKRA_DATABASE_URL 时启用数据库模式；未配置时 API 走文件证据 fallback。
# 格式: postgresql+psycopg://用户名:密码@主机:端口/数据库名
# 本地开发（PostgreSQL 18 Windows 服务）:
OKRA_DATABASE_URL=postgresql+psycopg://okra:YOUR_OKRA_PASSWORD@localhost:5432/okra_cold_storage

# Docker Compose 内部（使用 service 名 db）:
# OKRA_DATABASE_URL=postgresql+psycopg://okra:YOUR_OKRA_PASSWORD@db:5432/okra_cold_storage

# ── 高德地图 ─────────────────────────────────────────────────
# provider 设为 amap 才启用真实底图；留 file 则降级为文件点位
OKRA_MAP_PROVIDER=amap

# 向浏览器下发 JS Key 的开关（设 true 前确认已配置 OKRA_AMAP_JS_KEY）
OKRA_MAP_PUBLIC_KEY_ALLOWED=true

# 高德 JS API Key（前端地图，仅在 PUBLIC_KEY_ALLOWED=true 时才下发）
OKRA_AMAP_JS_KEY=YOUR_AMAP_JS_KEY_HERE

# 高德 Web Service Key（后端地理编码 / 路径矩阵）
OKRA_AMAP_WEB_SERVICE_KEY=YOUR_AMAP_WEB_SERVICE_KEY_HERE

# 高德 JS API 安全码（2021+ 密钥需要；没有可留空）
OKRA_AMAP_SECURITY_CODE=

# ── Gurobi（仅本地求解用，容器内无需配置）───────────────────
# Node 许可证路径；Docker 容器不运行 Gurobi，可注释掉
GRB_LICENSE_FILE=D:\Gurobi1300\win64\bin\gurobi.lic

# ── 物流系统集成（P1 真实联调时填入）───────────────────────
# 留空则使用 file-fallback mock adapter
LOGISTICS_BASE_URL=

# ── FastAPI 服务 ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8014

# ── PostgreSQL 初始化（仅 Docker Compose postgres service 用）
POSTGRES_DB=okra_cold_storage
POSTGRES_USER=okra
POSTGRES_PASSWORD=YOUR_OKRA_PASSWORD
